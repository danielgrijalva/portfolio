---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import { details, photos } from "../lib/photos";
import avatar from "../assets/images/avatar.webp";

const featured = photos.slice(0, 6);

const projects = [
  {
    title: "BeeMaps",
    link: "https://beemaps.com.mx",
    description: "A real-estate platform for brokers and buyers in north-west México. I built it and I run it.",
  },
  {
    title: "Overworld",
    link: "https://github.com/danielgrijalva/overworld",
    description: "A site for keeping track of the games I've played. Currently rebuilding it from scratch.",
  },
  {
    title: "Ghostwriter",
    link: "https://github.com/danielgrijalva/ghostwriter",
    description: "An experiment in AI-assisted writing, built with Keras and Vue.",
  },
  {
    title: "Sistema A3",
    link: "https://www.sistemaa3.com/propiedades/venta",
    description: "The property system I built for a real-estate company, front to back.",
  },
  {
    title: "Datasets",
    link: "https://www.kaggle.com/danielgrijalvas",
    description: "Datasets I've put together on Kaggle to answer questions I was curious about.",
  },
  {
    title: "Scrapers",
    link: "https://github.com/danielgrijalva/infocasas",
    description: "A pile of web scrapers, mostly for freelance clients.",
  },
];

const work = [
  { years: "2024–now", place: "BeeMaps", what: "Founder. Started Aug 2024, live since Apr 2025" },
  { years: "2022–now", place: "Improving", what: "Consulting: platforms, AWS/Terraform, AI and vision pipelines" },
  { years: "2022", place: "Turn Technologies", what: "Backend APIs and third-party integrations" },
  { years: "2021", place: "A Terceros", what: "Built their internal web app from scratch" },
  { years: "2020", place: "Freelance", what: "Scrapers, data cleanup, Django sites, some video editing" },
  { years: "2019", place: "Nearsoft", what: "Full-stack features in Flask and React" },
  { years: "2018", place: "Prodigia", what: "Route optimisation with the Google Maps API" },
];

const elsewhere = [
  { label: "Email", href: "mailto:danielgrisoto@gmail.com" },
  { label: "GitHub", href: "https://github.com/danielgrijalva" },
  { label: "Kaggle", href: "https://www.kaggle.com/danielgrijalvas" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/danielgrijalva/" },
  { label: "Last.fm", href: "https://www.last.fm/user/jdgsgt" },
];
---

<Base>
  <main>
    <header class="intro">
      <div class="name">
        <Image src={avatar} alt="" width={80} height={80} loading="eager" class="avatar" />
        <div>
          <h1>Daniel Grijalva</h1>
          <p class="role">Software engineer &amp; film photographer</p>
        </div>
      </div>
      <p>
        I'm Daniel, a software engineer in México. These days I'm a consultant at Improving, building web services and
        platforms for large customers, mostly in Python on AWS, lately with a lot of AI and vision pipelines.
        I also run <a class="link" href="https://beemaps.com.mx">BeeMaps</a>, a real-estate platform for brokers and
        buyers in north-west México.
      </p>
      <p>
        Outside of work I shoot film, mostly on a Minolta SRT 101, and I listen to a lot of music. The photographs
        below are mine.
      </p>
    </header>

    <section id="photography" class="photos-section" aria-labelledby="photography-title">
      <h2 id="photography-title">Photographs</h2>
      {
        featured.length > 0 ? (
          <div class="frames">
            {featured.map((photo, i) => (
              <figure>
                <a href="/photos" style={`aspect-ratio: ${photo.width} / ${photo.height}`}>
                  <Photo photo={photo} sizes="(min-width: 960px) 440px, (min-width: 640px) 45vw, 100vw" eager={i < 2} />
                </a>
                {details(photo) && <figcaption class="meta">{details(photo)}</figcaption>}
              </figure>
            ))}
          </div>
        ) : (
          <p class="muted">Photos coming soon.</p>
        )
      }
      <p><a class="link" href="/photos">More on the photos page →</a></p>
    </section>

    <section aria-labelledby="made-title">
      <h2 id="made-title">Things I've made</h2>
      <ul class="rows">
        {
          projects.map((p) => (
            <li>
              <a class="row-title link" href={p.link} target="_blank" rel="noopener">
                {p.title}
              </a>
              <span class="muted">{p.description}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="work-title">
      <h2 id="work-title">Work</h2>
      <ul class="rows work">
        {
          work.map((job) => (
            <li>
              <span class="meta years">{job.years}</span>
              <span>
                {job.place} <span class="muted">· {job.what}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="elsewhere-title">
      <h2 id="elsewhere-title">Elsewhere</h2>
      <p class="elsewhere">
        {
          elsewhere.map(({ label, href }) => (
            <a class="link" href={href} target={href.startsWith("mailto:") ? undefined : "_blank"} rel="noopener">
              {label}
            </a>
          ))
        }
      </p>
      <p class="muted">
        The best way to reach me is email: <a class="link" href="mailto:danielgrisoto@gmail.com"
          >danielgrisoto@gmail.com</a
        >.
      </p>
    </section>

    <footer class="meta">
      Built with Astro and hosted on Cloudflare. Photos shot on film, mostly with a Minolta SRT 101.
    </footer>
  </main>
</Base>

<style>
  /* 38rem of text, plus the 1.25rem gutters. */
  main {
    max-width: 40.5rem;
    margin: 0 auto;
    padding: 6rem 1.25rem 4rem;
  }

  section,
  footer {
    margin-top: 5.5rem;
  }

  h1,
  h2 {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  h2 {
    margin-bottom: 1rem;
  }

  .muted,
  .role {
    color: var(--muted);
  }

  /* Intro */
  .name {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 2rem;
  }
  .name :global(.avatar) {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    object-fit: cover;
  }
  .intro p + p {
    margin-top: 1rem;
  }

  /* Photographs: allowed to break out wider than the text column. */
  .photos-section {
    width: min(56rem, calc(100vw - 2.5rem));
    margin-left: 50%;
    transform: translateX(-50%);
  }
  .photos-section > h2,
  .photos-section > p {
    max-width: 38rem;
    margin-left: auto;
    margin-right: auto;
  }
  .frames {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.25rem;
    align-items: start;
    margin-bottom: 1.75rem;
  }
  @media (min-width: 640px) {
    .frames {
      grid-template-columns: 1fr 1fr;
    }
  }
  figure a {
    display: block;
    background: var(--photo-bg);
  }
  figure :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin-top: 0.5rem;
  }

  /* Lists */
  .rows {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .rows li {
    display: flex;
    flex-direction: column;
  }
  .row-title {
    width: fit-content;
  }
  .work li {
    flex-direction: row;
    gap: 1rem;
  }
  .years {
    flex: none;
    width: 4.75rem;
    padding-top: 0.2rem;
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 1rem;
  }
</style>
