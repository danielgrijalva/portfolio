---
import Base from "../layouts/Base.astro";
---

<Base title="Not found - Daniel Grijalva">
  <main class="flex min-h-svh flex-col items-start justify-center gap-4 px-5 font-poppins sm:items-center sm:text-center">
    <p class="text-sm text-zinc-500 tabular-nums">404</p>
    <h1 class="text-4xl font-medium text-balance md:text-5xl">This frame didn't develop.</h1>
    <p class="max-w-md font-light text-zinc-400">
      There's nothing at this address. It may have moved, or the link was off by a letter.
    </p>
    <a href="/" class="mt-4 rounded-full border-2 border-zinc-500 px-6 py-2.5 transition-colors hover:border-white">
      Back home
    </a>
  </main>
</Base>
