---
import Base from "../layouts/Base.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import { photos } from "../lib/photos";
---

<Base title="Photography - Daniel Grijalva" description="Photography by Daniel Grijalva">
  <div class="wrap">
    <header>
      <a href="/#photography" class="back">← Daniel Grijalva</a>
      <h1>Photography</h1>
      <p>Shot on film, mostly with a Minolta SRT 101.</p>
    </header>
    {photos.length > 0 ? <PhotoGrid photos={photos} /> : <p class="empty">The first roll is still in the developing tank. Check back soon.</p>}
  </div>
</Base>

<style>
  @reference "../styles/global.css";

  .wrap {
    @apply mx-auto max-w-7xl px-4 py-12 md:px-8 md:py-20;
  }
  header {
    @apply mb-10 font-poppins;
  }
  .back {
    @apply text-sm text-zinc-400 transition-colors hover:text-white;
  }
  h1 {
    @apply mt-6 text-4xl font-medium md:text-6xl;
  }
  header p,
  .empty {
    @apply mt-2 font-light text-zinc-400;
  }
</style>
