---
import Base from "../layouts/Base.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import { photos } from "../lib/photos";
---

<Base title="Photographs - Daniel Grijalva" description="Film photographs by Daniel Grijalva.">
  <div class="wrap">
    <header>
      <a href="/" class="link back">← Daniel Grijalva</a>
      <h1>Photographs</h1>
      <p>Shot on film, mostly with a Minolta SRT 101.</p>
    </header>
    {photos.length > 0 ? <PhotoGrid photos={photos} /> : <p class="empty">Photos coming soon.</p>}
  </div>
</Base>

<style>
  .wrap {
    max-width: 80rem;
    margin: 0 auto;
    padding: 4rem 1.25rem 5rem;
  }
  header {
    max-width: 38rem;
    margin-bottom: 3rem;
  }
  .back {
    font-size: 0.875rem;
  }
  h1 {
    margin-top: 2.5rem;
    font-size: 1rem;
    font-weight: 500;
  }
  header p,
  .empty {
    color: var(--muted);
  }
</style>
