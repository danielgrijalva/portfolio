---
import { Image } from "astro:assets";
import avatar from "../assets/images/avatar.webp";

const SECTIONS = [
  { id: "hello", label: "Hello" },
  { id: "photography", label: "Photography" },
  { id: "projects", label: "Projects" },
  { id: "work", label: "Work" },
  { id: "me", label: "About me" },
  { id: "contact", label: "Say hi" },
];

const ROMAN = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII"];
---

<div class="nav-wrapper">
  <div class="brand-wrapper">
    <a href="#hello" class="brand">
      <Image src={avatar} alt="Daniel Grijalva" width={128} height={128} loading="eager" />
      <span>Daniel Grijalva</span>
    </a>
    <button class="menu" aria-label="Open menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
  <nav>
    {
      SECTIONS.map(({ id, label }, i) => (
        <a href={`#${id}`} class="link" data-nav={id}>
          <span class="number">{ROMAN[i]}.</span>
          <span class="label">{label}</span>
        </a>
      ))
    }
  </nav>
</div>

<script>
  const nav = document.querySelector("nav")!;
  const menu = document.querySelector<HTMLButtonElement>(".menu")!;

  const setOpen = (open: boolean) => {
    nav.classList.toggle("open", open);
    menu.setAttribute("aria-expanded", String(open));
  };
  menu.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
  nav.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));

  // Highlight the section that's on screen, and its nav link.
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        entry.target.classList.toggle("active", entry.isIntersecting);
        if (entry.isIntersecting) {
          nav.querySelectorAll<HTMLElement>("[data-nav]").forEach((link) => {
            link.classList.toggle("current", link.dataset.nav === entry.target.id);
          });
        }
      }
    },
    { threshold: 0.5 },
  );
  document.querySelectorAll("[data-section]").forEach((s) => observer.observe(s));
</script>

<style>
  @reference "../styles/global.css";

  .nav-wrapper {
    @apply absolute top-0 z-50 h-screen w-full flex-col items-start justify-center gap-24 lg:fixed lg:flex lg:w-72;
  }

  nav {
    @apply mt-16 hidden w-full overflow-x-hidden lg:block;
  }

  nav.open {
    @apply fixed top-0 flex flex-col bg-zinc-900 pb-4 shadow-[0_16px_32px_-8px_rgb(0_0_0/0.6)] lg:relative lg:top-auto lg:bg-transparent lg:pb-0 lg:shadow-none;
  }

  .brand-wrapper {
    @apply fixed flex h-16 w-full items-center justify-between bg-zinc-900/95 px-5 backdrop-blur sm:px-8 lg:relative lg:h-auto lg:bg-transparent lg:px-6 lg:backdrop-blur-none;
  }

  .menu {
    @apply -mr-2 flex h-11 w-11 cursor-pointer items-center justify-center rounded-lg lg:hidden;
  }

  .menu svg {
    @apply h-7 w-7;
  }

  .brand {
    @apply flex items-center gap-3;
  }

  .brand img {
    @apply w-10 rounded-full object-cover lg:w-16;
  }

  .brand span {
    @apply font-poppins font-light text-zinc-300 lg:text-xl;
  }

  .link {
    @apply flex w-full items-baseline justify-between rounded-none px-5 py-3 text-xl font-medium transition-colors sm:px-8 lg:rounded-tr-md lg:rounded-br-md lg:px-6 lg:py-2.5;
  }

  .link.current {
    @apply bg-white text-zinc-900;
  }

  .number {
    @apply text-base text-zinc-500 tabular-nums;
  }

  .link.current .number {
    @apply text-zinc-900;
  }

  .label {
    @apply ml-6 whitespace-nowrap lg:text-2xl;
  }
</style>
