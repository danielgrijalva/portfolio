---
import Photo from "./Photo.astro";
import { details, largest, photoUrl, type Photo as PhotoData } from "../lib/photos";

interface Props {
  photos: PhotoData[];
}

const { photos } = Astro.props;
---

<div class="gallery">
  {
    photos.map((photo, i) => (
      <a
        class="item"
        href={photoUrl(photo, largest(photo), "jpg")}
        data-avif={photoUrl(photo, largest(photo), "avif")}
        data-alt={photo.alt}
        data-details={details(photo)}
        style={`aspect-ratio: ${photo.width} / ${photo.height}`}
      >
        <Photo
          photo={photo}
          sizes="(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 100vw"
          eager={i < 3}
        />
      </a>
    ))
  }
</div>

<dialog class="lightbox" aria-label="Photo viewer">
  <button class="close" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>
  <picture>
    <source type="image/avif" />
    <img alt="" />
  </picture>
  <p class="details"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog.lightbox")!;
  const source = dialog.querySelector("source")!;
  const img = dialog.querySelector("img")!;
  const details = dialog.querySelector(".details")!;

  document.querySelectorAll<HTMLAnchorElement>(".gallery .item").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      source.srcset = link.dataset.avif ?? "";
      img.src = link.href;
      img.alt = link.dataset.alt ?? "";
      details.textContent = link.dataset.details ?? "";
      dialog.showModal();
    });
  });

  dialog.querySelector(".close")!.addEventListener("click", () => dialog.close());
  // Clicking the dark backdrop (outside the photo) closes the viewer.
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .gallery {
    columns: 1;
    column-gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .gallery {
      columns: 2;
    }
  }
  @media (min-width: 1280px) {
    .gallery {
      columns: 3;
    }
  }

  .item {
    display: block;
    margin-bottom: 1.25rem;
    break-inside: avoid;
    background: var(--photo-bg);
  }

  .item :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The viewer stays dark in both themes: photos read best on black. */
  .lightbox {
    margin: auto;
    max-width: none;
    max-height: none;
    padding: 0;
    background: transparent;
    color: #e9e7e1;
  }

  .lightbox::backdrop {
    background: rgb(12 11 9 / 0.94);
  }

  .lightbox img {
    max-width: 92vw;
    max-height: 85vh;
    object-fit: contain;
  }

  .details {
    margin-top: 0.75rem;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: #9a978e;
  }

  .close {
    position: fixed;
    top: 0.75rem;
    right: 0.75rem;
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #9a978e;
    transition: color 0.15s ease;
  }

  .close:hover {
    color: #fff;
  }

  .close svg {
    width: 1.5rem;
    height: 1.5rem;
  }
</style>
