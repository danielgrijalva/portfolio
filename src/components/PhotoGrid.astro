---
import Photo from "./Photo.astro";
import { largest, photoUrl, type Photo as PhotoData } from "../lib/photos";

interface Props {
  photos: PhotoData[];
}

const { photos } = Astro.props;
const details = (p: PhotoData) =>
  [p.caption, p.film, p.camera, p.takenAt?.slice(0, 4)].filter(Boolean).join(" · ");
---

<div class="gallery">
  {
    photos.map((photo, i) => (
      <a
        class="item"
        href={photoUrl(photo, largest(photo), "jpg")}
        data-avif={photoUrl(photo, largest(photo), "avif")}
        data-alt={photo.alt}
        data-details={details(photo)}
        style={`aspect-ratio: ${photo.width} / ${photo.height}`}
      >
        <Photo
          photo={photo}
          sizes="(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 100vw"
          eager={i < 3}
        />
      </a>
    ))
  }
</div>

<dialog class="lightbox" aria-label="Photo viewer">
  <button class="close" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
      <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18"></path>
    </svg>
  </button>
  <picture>
    <source type="image/avif" />
    <img alt="" />
  </picture>
  <p class="details"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("dialog.lightbox")!;
  const source = dialog.querySelector("source")!;
  const img = dialog.querySelector("img")!;
  const details = dialog.querySelector(".details")!;

  document.querySelectorAll<HTMLAnchorElement>(".gallery .item").forEach((link) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      source.srcset = link.dataset.avif ?? "";
      img.src = link.href;
      img.alt = link.dataset.alt ?? "";
      details.textContent = link.dataset.details ?? "";
      dialog.showModal();
    });
  });

  dialog.querySelector(".close")!.addEventListener("click", () => dialog.close());
  // Clicking the dark backdrop (outside the photo) closes the viewer.
  dialog.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  @reference "../styles/global.css";

  .gallery {
    @apply columns-1 gap-3 sm:columns-2 md:gap-4 xl:columns-3;
  }

  .item {
    @apply mb-3 block overflow-hidden rounded-lg bg-zinc-800 break-inside-avoid md:mb-4;
  }

  .item :global(img) {
    @apply h-full w-full object-cover transition-transform duration-500 hover:scale-[1.02];
  }

  .lightbox {
    @apply m-auto max-h-none max-w-none bg-transparent p-0 text-white;
  }

  .lightbox::backdrop {
    @apply bg-black/90;
  }

  .lightbox img {
    @apply max-h-[85vh] max-w-[92vw] object-contain;
  }

  .details {
    @apply mt-3 text-center font-poppins text-sm font-light text-zinc-400;
  }

  .close {
    @apply fixed top-3 right-3 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full text-zinc-300 transition-colors hover:bg-white/10 hover:text-white;
  }

  .close svg {
    @apply h-6 w-6;
  }
</style>
